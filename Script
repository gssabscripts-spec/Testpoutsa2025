-- Ultimate Anti-Cheat & Telemetry Bypass Hook
pcall(function()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" or method == "kick" or method == "Detect" or method == "Report" or method == "CheckPosition" or method == "TeleportDetect" then
            return nil
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end)

-- God-Tier Global Map Steal (Bypasses distance limits entirely)
local function globalGodSteal()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parentName = obj.Parent and obj.Parent.Name:lower() or ""
            local actionText = obj.ActionText:lower()
            
            if string.find(actionText, "steal") or string.find(parentName, "brainrot") or string.find(parentName, "brain") then
                pcall(function()
                    fireproximityprompt(obj, 0)
                end)
            end
        end
    end
end

-- Teleport Down Function (Safely raycasts or shifts downward without rubberbanding)
local function teleportDown()
    local localPlayer = game:GetService("Players").LocalPlayer
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    local rootPart = character.HumanoidRootPart
    
    -- Cast a ray straight down to find the nearest ground, or drop down 30 studs safely
    local rayOrigin = rootPart.Position
    local rayDirection = Vector3.new(0, -250, 0)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local raycastResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)

    if raycastResult then
        -- Smoothly adjust velocity to prevent anti-cheat velocity flags, then land on ground
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.CFrame = CFrame.new(raycastResult.Position + Vector3.new(0, 3, 0)) * rootPart.CFrame.Rotation
    else
        -- Fallback if no ground is directly detected beneath
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.CFrame = rootPart.CFrame - Vector3.new(0, 30, 0)
    end
end

